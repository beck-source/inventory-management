# Copy to .env (gitignored) and fill in. Never commit real values.
# AI restocking recommendations need ONE of the two options below (used server-side only).

# Option A - Claude Platform on AWS (key created in the AWS Console). Takes precedence if set.
ANTHROPIC_AWS_API_KEY=
AWS_REGION=
ANTHROPIC_AWS_WORKSPACE_ID=

# Option B - first-party Claude API key (starts with sk-ant-)
ANTHROPIC_API_KEY=
